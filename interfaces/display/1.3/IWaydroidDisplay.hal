package vendor.waydroid.display@1.3;
import vendor.waydroid.display@1.2;
import android.hardware.graphics.composer@2.1::types;

interface IWaydroidDisplay extends @1.2::IWaydroidDisplay {
    // Stable HWC2 layer ID, never the Z order or HWC1 array position.
    // 0 withdraws the metadata; 1 is explicit mono. See stereo/README.md.
    setStereoLayout(uint64_t layer, int32_t layout) generates (Error error);
};
