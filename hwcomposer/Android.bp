// HAL module implemenation stored in
// hw/<OVERLAY_HARDWARE_MODULE_ID>.<ro.product.board>.so
cc_library_shared {
    name: "hwcomposer.waydroid",
    relative_install_path: "hw",
    vendor: true,
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libsync",
        "libui",
        "libdrm",
        "libEGL",
        "libGLESv2",
        "vendor.waydroid.clipboard@1.0",
        "vendor.waydroid.display@1.0",
        "vendor.waydroid.display@1.1",
        "vendor.waydroid.display@1.2",
        "vendor.waydroid.display@1.3",
        "vendor.waydroid.task@1.0",
        "vendor.waydroid.window@1.0",
        "vendor.waydroid.window@1.1",
        "vendor.waydroid.window@1.2",
    ],
    static_libs: [
        "libwayland_client_static",
        "libffi",
        "libwayland_extension_client_protocols",
        "libxkbcommon",
    ],
    srcs: [
        "extension.cpp",
        "gralloc_handler.cpp",
        "stereo/layout.cpp",
        "stereo/composition.cpp",
        "stereo/surface.cpp",
        "hwcomposer.cpp",
        "wayland-hwc.cpp",
        "WaydroidClipboard.cpp",
        "WaydroidWindow.cpp",
        "egl-tools.cpp",
        "modes/waydroid_mode.cpp",
        "modes/closed.cpp",
        "modes/full-ui.cpp",
        "modes/multi-window.cpp",
        "modes/single-window.cpp",
    ],
    header_libs: [
        "libsystem_headers",
        "minigbm_headers",
    ],
    include_dirs: [
        "system/core",
        "system/core/libsync",
        "system/core/libsync/include"
    ],
    cflags: [
        "-DLOG_TAG=\"hwcomposer\"",
        "-Wall",
        "-Werror",
    ],
    generated_sources: ["wayland_android_client_protocol_sources", "waydroid_stereo_protocol_source"],
    generated_headers: ["wayland_android_client_protocol_headers", "waydroid_stereo_protocol_header"],
}

// Generate wayland-android protocol source file
genrule {
    name: "wayland_android_client_protocol_sources",
    srcs: ["wayland-android.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) code < $(in) > $(out)",
    out: ["wayland-android-client-protocol.c"],
}
// Generate wayland-android protocol header file
genrule {
    name: "wayland_android_client_protocol_headers",
    srcs: ["wayland-android.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
    out: ["wayland-android-client-protocol.h"],
}

cc_library_headers {
    name: "waydroid_stereo_identity_headers",
    vendor: true,
    export_include_dirs: ["stereo"],
}

genrule {
    name: "waydroid_stereo_protocol_source",
    srcs: ["stereo/kde-stereo-content-v1.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) private-code < $(in) > $(out)",
    out: ["kde-stereo-content-v1-protocol.c"],
}
genrule {
    name: "waydroid_stereo_protocol_header",
    srcs: ["stereo/kde-stereo-content-v1.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
    out: ["kde-stereo-content-v1-client-protocol.h"],
}
cc_test_host {
    name: "waydroid_stereo_layout_test",
    srcs: ["stereo/layout.cpp", "stereo/layout_test.cpp",
           "stereo/composition.cpp", "stereo/composition_test.cpp"],
    cflags: ["-Wall", "-Werror"],
}
